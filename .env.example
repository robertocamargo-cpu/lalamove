# Configurações da API Lalamove v3
# Obtenha suas credenciais no Portal de Parceiros: https://partner.lalamove.com/
LALAMOVE_API_KEY=sua_api_key_aqui
LALAMOVE_API_SECRET=seu_api_secret_aqui

# Ambiente: "sandbox" para testes ou "production" para ambiente real
LALAMOVE_ENV=sandbox

# Mercado (Padrão BR para o Brasil)
LALAMOVE_MARKET=BR

# Modo de Simulação (se true, permite testar sem credenciais Lalamove ativas gerando dados e rotas realistas)
LALAMOVE_MOCK_FALLBACK=true

